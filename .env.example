# ==============================================================
# Smart City 360 – Production Environment Configuration
# ==============================================================

# Application Environment
NODE_ENV=production
PORT=3000

# --------------------------------------------------------------
# Database Configuration (MySQL)
# --------------------------------------------------------------
# Option 1: Standard Connection URL (Render, Railway, Heroku, Supabase, PlanetScale)
# DATABASE_URL=mysql://dbuser:StrongPassword123@db-host.provider.com:3306/smart_city_360?ssl=true

# Option 2: Individual Connection Parameters
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=smartcity_app
DB_PASSWORD=SecureProductionPassword_2026!
DB_NAME=smart_city_360

# Enable SSL for Cloud MySQL (AWS RDS, DigitalOcean, PlanetScale, Aiven, Railway)
DB_SSL=false
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------------
# Security & Authentication
# --------------------------------------------------------------
# Generate a cryptographically random 64-character secret for production:
# (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=production_super_secret_jwt_key_replace_with_random_64_chars
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (Comma-separated for multiple domains, or * for public API)
# Example: https://smartcity360.gov.in,https://admin.smartcity360.gov.in
CORS_ORIGIN=*

# Rate Limiting (Requests per 15 minutes per IP)
RATE_LIMIT_MAX=300

# --------------------------------------------------------------
# Upload Configuration
# --------------------------------------------------------------
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# --------------------------------------------------------------
# External Government Gateway Integration (Optional)
# --------------------------------------------------------------
GOV_API_ENABLED=true
GOV_API_ENDPOINT=https://api.smartcity360.gov.in/v1/grievance
GOV_API_KEY=sc360_live_production_api_key
